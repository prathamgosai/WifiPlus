# Security headers that CANNOT be set from a <meta> tag and must come from the server.
# Read automatically by Netlify and Cloudflare Pages. GitHub Pages ignores this file —
# if you stay on Pages, put Cloudflare in front of the domain and set these as
# Transform Rules there, otherwise clickjacking + HSTS protection stays off.

/*
  # Clickjacking: refuse to be embedded in any frame.
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  # Force HTTPS for 2 years, including subdomains.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Stop browsers guessing a response is a different type than declared.
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Deny hardware/location APIs the speed test never uses.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# The service worker must never be cached, or a fix can never reach anyone: the
# browser keeps serving the old worker, which keeps serving the old app shell.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# The shell is unhashed and hand-deployed, so it has to be revalidated on every
# load. Without this a CDN can serve last week's HTML against this week's JS.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/app.js
  Cache-Control: public, max-age=0, must-revalidate

/core/*
  Cache-Control: public, max-age=0, must-revalidate
