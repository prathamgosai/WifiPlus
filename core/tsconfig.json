{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // The engine is plain ESM JavaScript with JSDoc types: no build step, so the
    // static site can import it straight from a <script type="module">, while
    // checkJs still gives it the same type safety as the TypeScript app.
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules"]
}
