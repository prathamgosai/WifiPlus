# Copy to .env and set per region. Each deployed edge uses the same image with a
# different REGION / SERVER_NAME so the frontend can identify which one answered.

HOST=0.0.0.0
PORT=8080

# Region identity (shown in the UI's server picker)
REGION=bom
SERVER_NAME=WifiPlus Edge — Mumbai
COUNTRY=India
CITY=Mumbai

# How a BROWSER reaches this server. Served verbatim from
# /api/speedtest/servers, so clients address the edge by this URL.
# It cannot be derived from the request: behind NGINX or Cloudflare the Host
# header is whatever the proxy passes on, and a wrong guess hands every client a
# URL that resolves nowhere. Defaults to http://localhost:PORT, which is correct
# for development and obviously wrong in production — set it.
PUBLIC_URL=https://bom.speed.example.com

# Optional coordinates, for the "distance to server" readout in the UI.
LAT=19.076
LON=72.8777

# Sibling edges to advertise alongside this one, as a JSON array. The client
# probes every entry itself and ranks by the latency IT measures — this server
# does not probe its peers, because its latency to Singapore says nothing about
# a browser's. A malformed value is ignored rather than crashing the server.
# PEERS=[{"id":"sin","name":"WifiPlus Edge — Singapore","country":"Singapore","city":"Singapore","url":"https://sin.speed.example.com"}]

# CORS: comma-separated origins allowed to call this server.
# Leave empty ONLY in local dev (reflects any origin).
ALLOWED_ORIGINS=https://wifiplus.prathamgosai.in

# Hard ceilings (bytes). 1 GiB download / 512 MiB upload by default.
MAX_DOWNLOAD_BYTES=1073741824
MAX_UPLOAD_BYTES=536870912

# Rate limit for metadata routes only (measurement routes are exempt).
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# true when behind NGINX / Cloudflare (trust X-Forwarded-For)
TRUST_PROXY=true

LOG_LEVEL=info
